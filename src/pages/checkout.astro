---
import Layout from '../layouts/Layout.astro';
const base = (import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/');
---
<Layout title="Checkout — Over2You">
  <div class="checkout-wrapper" id="checkoutWrapper" style="max-width:1100px;margin:0 auto;padding:6rem var(--container-gutter) 4rem;">
    <p style="text-align:center;color:rgb(var(--text-color)/0.4);">Loading checkout...</p>
  </div>
</Layout>

<style is:inline>
  .checkout-wrapper { display:grid; grid-template-columns:1fr; gap:3rem; }
  @media (min-width:900px) { .checkout-wrapper { grid-template-columns:1.3fr 0.7fr; } }
  .checkout-title { font:var(--heading-font-style) 800 1.5rem/1.2 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:2rem; padding-bottom:1rem; border-bottom:1px solid rgb(var(--border-color)); }
  .form-section { margin-bottom:2rem; }
  .form-section-title { font:var(--heading-font-style) 700 var(--text-sm)/1.4 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1rem; color:rgb(var(--text-color)/0.6); }
  .form-row { display:grid; grid-template-columns:1fr; gap:0.75rem; margin-bottom:0.75rem; }
  .form-row.two-col { grid-template-columns:1fr 1fr; }
  @media (max-width:600px) { .form-row.two-col { grid-template-columns:1fr; } }
  .form-group { display:flex; flex-direction:column; gap:0.3rem; }
  .form-group label { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:rgb(var(--text-color)/0.6); }
  .form-group input,.form-group select,.form-group textarea { padding:0.7rem 0.8rem; border:1px solid rgb(var(--border-color)); font:var(--text-font-style) var(--text-font-weight) var(--text-base)/1.65 var(--text-font-family); color:rgb(var(--text-color)); background:rgb(var(--background)); outline:none; border-radius:0; transition:border-color 0.2s; }
  .form-group input:focus,.form-group select:focus,.form-group textarea:focus { border-color:rgb(var(--text-color)); }
  .form-group input.error { border-color:#c94c4c; }
  .payment-methods { margin:1.5rem 0; }
  .payment-option { display:flex; align-items:flex-start; gap:0.75rem; padding:1rem; border:1px solid rgb(var(--border-color)); margin-bottom:-1px; cursor:pointer; transition:background 0.2s; }
  .payment-option:hover { background:rgb(var(--text-color)/0.02); }
  .payment-option.selected { background:rgb(var(--text-color)/0.03); border-color:rgb(var(--text-color)); z-index:1; position:relative; }
  .payment-option input[type="radio"] { margin-top:2px; accent-color:rgb(var(--text-color)); }
  .payment-option-label { font:var(--heading-font-style) 600 var(--text-sm)/1.4 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.2rem; }
  .payment-option-desc { font-size:11px; color:rgb(var(--text-color)/0.5); }
  .bank-details { display:none; padding:1rem; background:#f9f9f9; border:1px solid rgb(var(--border-color)); border-top:none; font-size:var(--text-sm); line-height:1.8; }
  .bank-details.visible { display:block; }
  .order-summary { position:sticky; top:80px; height:fit-content; }
  .order-summary-title { font:var(--heading-font-style) 700 var(--text-sm)/1.4 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1.5rem; padding-bottom:0.75rem; border-bottom:1px solid rgb(var(--border-color)); }
  .summary-item { display:flex; gap:1rem; padding:0.75rem 0; border-bottom:1px solid rgb(var(--border-color)/0.15); }
  .summary-item-swatch { width:50px; height:65px; flex-shrink:0; }
  .summary-item-name { font:var(--heading-font-style) 600 11px/1.4 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.15rem; }
  .summary-item-variant { font-size:10px; color:rgb(var(--text-color)/0.5); }
  .summary-item-price { font-size:var(--text-sm); font-weight:600; text-align:right; white-space:nowrap; }
  .summary-totals { margin-top:1rem; }
  .summary-row { display:flex; justify-content:space-between; padding:0.4rem 0; font-size:var(--text-sm); }
  .summary-row.total { font:var(--heading-font-style) 700 var(--text-base)/1.4 var(--heading-font-family); border-top:1px solid rgb(var(--border-color)); padding-top:0.75rem; margin-top:0.5rem; }
  .btn-place-order { display:block; width:100%; padding:1rem; background:rgb(var(--button-background)); color:rgb(var(--button-text-color)); font:var(--heading-font-style) 800 var(--text-sm)/1.65 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.03em; text-align:center; border:none; cursor:pointer; margin-top:1.5rem; transition:opacity 0.3s; }
  .btn-place-order:hover { opacity:0.85; }
  .btn-place-order:disabled { opacity:0.4; cursor:not-allowed; }
  .btn-whatsapp { display:flex; align-items:center; justify-content:center; gap:0.5rem; width:100%; padding:0.85rem; background:#25D366; color:#fff; font:var(--heading-font-style) 700 var(--text-sm)/1.65 var(--heading-font-family); text-transform:uppercase; letter-spacing:0.03em; border:none; cursor:pointer; margin-top:0.75rem; transition:opacity 0.3s; }
  .btn-whatsapp:hover { opacity:0.85; }
  .paytr-stage { display:none; }
  .paytr-stage.visible { display:block; }
  .paytr-stage iframe { width:100%; min-height:520px; border:0; }
  .test-banner { background:#fff3cd; border:1px solid #f0d000; color:#5c4a00; padding:0.6rem 0.9rem; font-size:12px; font-weight:600; letter-spacing:0.04em; text-transform:uppercase; margin-bottom:1.5rem; }
  .fail-banner { background:#fdecec; border:1px solid #c94c4c; color:#7a1f1f; padding:0.8rem 1rem; font-size:var(--text-sm); margin-bottom:1.5rem; line-height:1.6; }
  .form-error { color:#c94c4c; font-size:12px; margin-top:0.75rem; min-height:16px; }
  .secure-badge { display:flex; align-items:center; justify-content:center; gap:0.5rem; margin-top:1rem; font-size:10px; color:rgb(var(--text-color)/0.4); text-transform:uppercase; letter-spacing:0.06em; }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', async () => {
  const wrapper = document.getElementById('checkoutWrapper');
  const B = window.O2Y_BASE;
  const items = Cart.getItems();
  const params = new URLSearchParams(window.location.search);
  const failedOid = params.get('fail');

  const t = (k, fallback) => (window.o2yT ? (o2yT(k) || fallback) : fallback);
  const money = (n) => '₺' + Number(n).toFixed(2);

  // Live config: PayTR availability + shipping/bank/whatsapp from settings.
  let paytrStatus = { enabled: false, testMode: null };
  let settings = {};
  try { const r = await fetch(B + 'api/paytr/status', { cache: 'no-store' }); if (r.ok) paytrStatus = await r.json(); } catch (e) {}
  try { const r = await fetch(B + 'data/settings.json', { cache: 'no-store' }); if (r.ok) settings = await r.json(); } catch (e) {}

  // Failed-payment landing (PayTR merchant_fail_url). Cart is intact, so we re-render the form.
  let failMsg = '';
  if (failedOid) {
    failMsg = 'Ödeme tamamlanamadı. Kartınızdan çekim yapılmadı; tekrar deneyebilir veya farklı bir yöntem seçebilirsiniz.';
    try {
      const r = await fetch(B + 'api/orders/' + encodeURIComponent(failedOid), { cache: 'no-store' });
      if (r.ok) { const o = await r.json(); if (o.failedReason) failMsg += ' (' + o.failedReason + ')'; }
    } catch (e) {}
  }

  if (items.length === 0) {
    wrapper.innerHTML = '<div style="text-align:center;padding:4rem;grid-column:1/-1;">' + (failMsg ? '<div class="fail-banner">' + failMsg + '</div>' : '') + '<h2 data-i18n="cart.empty" style="font:var(--heading-font-style) 800 1.25rem/1.2 var(--heading-font-family);text-transform:uppercase;margin-bottom:1rem;">Sepetiniz boş</h2><p style="color:rgb(var(--text-color)/0.5);margin-bottom:1.5rem;">Ödeme öncesi ürün ekleyin.</p><a href="'+B+'shop" class="btn-primary" style="display:inline-block;padding:0.75rem 2rem;">ALIŞVERİŞE DEVAM</a></div>';
    if (typeof window.o2yApplyLang === 'function') window.o2yApplyLang(window.o2yLang || 'tr');
    return;
  }

  const subtotal = items.reduce((s,i) => s + (i.price*i.qty), 0);
  const threshold = Number(settings.freeShippingThreshold);
  const shipCost = Number(settings.shippingCost);
  const shipping = (Number.isFinite(threshold) && subtotal >= threshold) ? 0 : (Number.isFinite(shipCost) ? shipCost : 0);
  const total = subtotal + shipping;
  const cardEnabled = !!paytrStatus.enabled;
  const defaultMethod = cardEnabled ? 'card' : 'bank';
  const bank = { name: settings.bankName || '', iban: settings.bankIBAN || '', holder: settings.bankHolder || '' };
  const waNumber = String(settings.whatsappNumber || '').replace(/[^0-9]/g, '');
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  wrapper.innerHTML = `
    <div class="checkout-form">
      <h1 class="checkout-title" data-i18n="checkout.title">SİPARİŞ</h1>
      ${failMsg ? '<div class="fail-banner">' + esc(failMsg) + '</div>' : ''}
      ${cardEnabled && paytrStatus.testMode ? '<div class="test-banner">TEST MODU — gerçek çekim yapılmaz</div>' : ''}
      <form id="orderForm" novalidate>
        <div class="form-section"><div class="form-section-title" data-i18n="checkout.contactInfo">İLETİŞİM BİLGİLERİ</div>
          <div class="form-row two-col"><div class="form-group"><label data-i18n="checkout.email">E-POSTA</label><input type="email" id="email" name="email" required autocomplete="email" placeholder="ornek@eposta.com"></div><div class="form-group"><label data-i18n="checkout.phone">TELEFON</label><input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="05XX XXX XX XX"></div></div>
        </div>
        <div class="form-section"><div class="form-section-title" data-i18n="checkout.shippingAddress">TESLİMAT ADRESİ</div>
          <div class="form-row two-col"><div class="form-group"><label data-i18n="checkout.firstName">AD</label><input type="text" id="firstName" name="firstName" required autocomplete="given-name"></div><div class="form-group"><label data-i18n="checkout.lastName">SOYAD</label><input type="text" id="lastName" name="lastName" required autocomplete="family-name"></div></div>
          <div class="form-row"><div class="form-group"><label data-i18n="checkout.address">ADRES</label><input type="text" id="address" name="address" required autocomplete="address-line1" placeholder="Mahalle, sokak, no"></div></div>
          <div class="form-row two-col"><div class="form-group"><label>Daire / Apartman</label><input type="text" id="address2" name="address2" autocomplete="address-line2"></div><div class="form-group"><label data-i18n="checkout.postalCode">POSTA KODU</label><input type="text" id="postalCode" name="postalCode" required autocomplete="postal-code"></div></div>
          <div class="form-row two-col"><div class="form-group"><label data-i18n="checkout.city">ŞEHİR</label><input type="text" id="city" name="city" required autocomplete="address-level2"></div><div class="form-group"><label data-i18n="checkout.country">ÜLKE</label><select id="country" name="country" required><option value="TR" selected>Türkiye</option><option value="DE">Almanya</option><option value="GB">Birleşik Krallık</option><option value="US">Amerika Birleşik Devletleri</option><option value="FR">Fransa</option><option value="NL">Hollanda</option></select></div></div>
          <div class="form-row"><div class="form-group"><label>Not (opsiyonel)</label><textarea id="notes" name="notes" rows="2"></textarea></div></div>
        </div>
        <div class="form-section"><div class="form-section-title" data-i18n="checkout.paymentMethod">ÖDEME YÖNTEMİ</div>
          <div class="payment-methods">
            ${cardEnabled ? '<label class="payment-option selected" data-method="card"><input type="radio" name="payment" value="card" checked><div><div class="payment-option-label" data-i18n="checkout.creditCard">KREDİ / BANKA KARTI</div><div class="payment-option-desc">Visa, Mastercard, Troy — PayTR güvenli ödeme sayfası, 3D Secure</div></div></label>' : ''}
            <label class="payment-option${cardEnabled ? '' : ' selected'}" data-method="bank"><input type="radio" name="payment" value="bank"${cardEnabled ? '' : ' checked'}><div><div class="payment-option-label">Havale / EFT</div><div class="payment-option-desc">Ödeme hesabımıza ulaşınca kargoya verilir</div></div></label>
            ${waNumber ? '<label class="payment-option" data-method="whatsapp"><input type="radio" name="payment" value="whatsapp"><div><div class="payment-option-label">WhatsApp ile Sipariş</div><div class="payment-option-desc">Sipariş özetini WhatsApp üzerinden bize gönderin</div></div></label>' : ''}
          </div>
          <div class="bank-details${cardEnabled ? '' : ' visible'}" id="bankDetails">${bank.iban ? '<strong>' + esc(bank.holder || 'Over2You') + '</strong><br>IBAN: ' + esc(bank.iban) + (bank.name ? '<br>Banka: ' + esc(bank.name) : '') + '<br><br><em>Havale açıklamasına sipariş numaranızı yazın. Sipariş numaranız bir sonraki sayfada gösterilecek.</em>' : '<em>IBAN bilgisi sipariş onay sayfasında gösterilecek.</em>'}</div>
        </div>
        <div class="form-error" id="formError"></div>
        <button type="submit" class="btn-place-order" id="placeOrderBtn"><span data-i18n="checkout.placeOrder">SİPARİŞİ TAMAMLA</span> — ${money(total)}</button>
        <button type="button" class="btn-whatsapp" id="whatsappBtn" style="display:none;">WHATSAPP İLE SİPARİŞ</button>
        <div class="secure-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>GÜVENLİ ÖDEME — 256-BIT SSL ŞİFRELEME</div>
      </form>
      <div class="paytr-stage" id="paytrStage">
        <div class="form-section-title">KART BİLGİLERİ</div>
        <p style="font-size:12px;color:rgb(var(--text-color)/0.5);margin-bottom:1rem;">Ödeme PayTR güvenli sayfasında alınır; kart bilgileriniz bize ulaşmaz.</p>
        <div id="paytrFrameHost"></div>
      </div>
    </div>
    <div class="order-summary">
      <div class="order-summary-title"><span data-i18n="checkout.summary">SİPARİŞ ÖZETİ</span> (${items.reduce((s,i)=>s+i.qty,0)})</div>
      ${items.map(i => {
        const swatchHex = i.selectedColorHex || i.color || '#eee';
        const colorLabel = i.selectedColorName ? t('common.color', 'Renk') + ': ' + esc(i.selectedColorName) + ' · ' : '';
        const sizeLabel = t('common.size', 'Beden') + ': ' + esc(i.selectedSize);
        return '<div class="summary-item"><div class="summary-item-swatch" style="background:'+esc(swatchHex)+';"></div><div><div class="summary-item-name">'+esc(i.name)+'</div><div class="summary-item-variant">'+colorLabel+sizeLabel+' · '+i.qty+'×</div></div><div class="summary-item-price">'+money(i.price*i.qty)+'</div></div>';
      }).join('')}
      <div class="summary-totals">
        <div class="summary-row"><span data-i18n="checkout.subtotal">Ara Toplam</span><span>${money(subtotal)}</span></div>
        <div class="summary-row"><span data-i18n="checkout.shippingFee">Kargo</span><span>${shipping===0?'<span data-i18n="checkout.free">ÜCRETSİZ</span>':money(shipping)}</span></div>
        <div class="summary-row total"><span data-i18n="checkout.totalLabel">Toplam</span><span>${money(total)}</span></div>
      </div>
    </div>
  `;
  if (typeof window.o2yApplyLang === 'function') window.o2yApplyLang(window.o2yLang || 'tr');

  const form = document.getElementById('orderForm');
  const errEl = document.getElementById('formError');
  const placeBtn = document.getElementById('placeOrderBtn');
  const waBtn = document.getElementById('whatsappBtn');
  let currentMethod = defaultMethod;

  document.querySelectorAll('.payment-option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.payment-option').forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
      opt.querySelector('input[type="radio"]').checked = true;
      currentMethod = opt.dataset.method;
      document.getElementById('bankDetails').classList.toggle('visible', currentMethod==='bank');
      placeBtn.style.display = currentMethod==='whatsapp'?'none':'block';
      waBtn.style.display = currentMethod==='whatsapp'?'flex':'none';
    });
  });

  function readCustomer() {
    let valid = true;
    form.querySelectorAll('[required]').forEach(inp => {
      const ok = inp.value.trim() && (inp.type !== 'email' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(inp.value.trim()));
      inp.classList.toggle('error', !ok);
      if (!ok) valid = false;
    });
    if (!valid) { errEl.textContent = 'Lütfen işaretli alanları doldurun.'; return null; }
    errEl.textContent = '';
    return {
      email: form.email.value.trim(), phone: form.phone.value.trim(),
      firstName: form.firstName.value.trim(), lastName: form.lastName.value.trim(),
      address: form.address.value.trim(), address2: form.address2.value.trim(),
      postalCode: form.postalCode.value.trim(), city: form.city.value.trim(),
      country: form.country.value, notes: form.notes.value.trim(),
    };
  }
  const payloadItems = () => items.map(i => ({ productId: i.id, colorId: i.selectedColorId || null, size: i.selectedSize, qty: i.qty }));

  async function postJSON(path, body) {
    const r = await fetch(B + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    let data = null; try { data = await r.json(); } catch (e) {}
    if (!r.ok) throw new Error((data && data.error) || ('Sunucu hatası (' + r.status + ')'));
    return data;
  }
  function busy(on) { placeBtn.disabled = on; waBtn.disabled = on; placeBtn.style.opacity = on ? '0.5' : ''; }

  async function startCardPayment(customer) {
    const data = await postJSON('api/paytr/token', { customer, items: payloadItems() });
    try { sessionStorage.setItem('o2y_pending_oid', data.oid); } catch (e) {}
    // Swap the form for the PayTR frame. Cart stays until /confirmation sees "paid".
    form.style.display = 'none';
    const stage = document.getElementById('paytrStage');
    const host = document.getElementById('paytrFrameHost');
    host.innerHTML = '';
    const iframe = document.createElement('iframe');
    iframe.id = 'paytriframe';
    iframe.src = data.iframeUrl;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('scrolling', 'no');
    iframe.style.width = '100%';
    host.appendChild(iframe);
    stage.classList.add('visible');
    const s = document.createElement('script');
    s.src = 'https://www.paytr.com/js/iframeResizer.min.js';
    s.onload = () => { try { window.iFrameResize({}, '#paytriframe'); } catch (e) {} };
    document.body.appendChild(s);
    stage.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function placeOfflineOrder(customer, method) {
    const data = await postJSON('api/orders', { paymentMethod: method, customer, items: payloadItems() });
    const oid = data.order.oid;
    if (method === 'whatsapp') {
      const num = String(data.whatsappNumber || '').replace(/[^0-9]/g, '') || waNumber;
      const msg = encodeURIComponent('Merhaba, ' + oid + ' numaralı siparişimi vermek istiyorum.\n' + data.order.items.map(i => '• ' + i.name + (i.colorName ? ' ' + i.colorName : '') + ' / ' + i.size + ' x' + i.qty).join('\n') + '\nToplam: ' + money(data.order.total) + '\nAd: ' + customer.firstName + ' ' + customer.lastName);
      if (num) window.open('https://wa.me/' + num + '?text=' + msg, '_blank');
    }
    localStorage.removeItem('over2you_cart');
    window.location.href = B + 'confirmation?order=' + encodeURIComponent(oid);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const customer = readCustomer(); if (!customer) return;
    busy(true);
    try {
      if (currentMethod === 'card') await startCardPayment(customer);
      else await placeOfflineOrder(customer, 'bank');
    } catch (err) { errEl.textContent = err.message || 'Bir hata oluştu, lütfen tekrar deneyin.'; busy(false); }
  });
  waBtn.addEventListener('click', async () => {
    const customer = readCustomer(); if (!customer) return;
    busy(true);
    try { await placeOfflineOrder(customer, 'whatsapp'); }
    catch (err) { errEl.textContent = err.message || 'Bir hata oluştu, lütfen tekrar deneyin.'; busy(false); }
  });
});
</script>
